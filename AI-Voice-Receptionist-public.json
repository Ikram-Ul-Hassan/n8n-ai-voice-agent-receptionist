    {
      "parameters": {
        "sendTo": "={{ $('Edit Fields').item.json.patient_email }}",
        "subject": "={{\n  'Appointment Confirmed | Bright Smile Dental Clinic - ' +\n  DateTime.fromISO($('Edit Fields').item.json.appointment_start)\n    .toFormat('dd LLL yyyy')\n}}",
        "message": "={{\n`<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Appointment Confirmed</title>\n</head>\n\n<body style=\"margin:0; padding:0; background-color:#f3f6f9; font-family:Arial, Helvetica, sans-serif; color:#1f2937;\">\n\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#f3f6f9; padding:30px 15px;\">\n    <tr>\n      <td align=\"center\">\n\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:620px; background-color:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 8px 24px rgba(15,23,42,0.08);\">\n\n          <!-- Header -->\n          <tr>\n            <td style=\"background-color:#0f766e; padding:28px 30px; text-align:center;\">\n              \n              <div style=\"font-size:28px; line-height:1; margin-bottom:10px;\">\n                🦷\n              </div>\n\n              <div style=\"font-size:20px; font-weight:700; color:#ffffff; letter-spacing:0.2px;\">\n                Bright Smile Dental Clinic\n              </div>\n\n              <div style=\"font-size:13px; color:#ccfbf1; margin-top:6px;\">\n                Professional dental care with a brighter smile\n              </div>\n\n            </td>\n          </tr>\n\n          <!-- Content -->\n          <tr>\n            <td style=\"padding:34px 32px 16px 32px;\">\n\n              <div style=\"text-align:center; margin-bottom:22px;\">\n                \n                <span style=\"display:inline-block; background-color:#dcfce7; color:#166534; font-size:13px; font-weight:700; padding:8px 14px; border-radius:999px;\">\n                  ✓ APPOINTMENT CONFIRMED\n                </span>\n\n              </div>\n\n              <h1 style=\"margin:0; text-align:center; font-size:26px; line-height:1.3; color:#111827;\">\n                Your appointment is confirmed\n              </h1>\n\n              <p style=\"margin:14px 0 0 0; text-align:center; font-size:15px; line-height:1.7; color:#6b7280;\">\n                Hi ${$('Edit Fields').item.json.patient_name}, your dental appointment has been successfully scheduled.\n              </p>\n\n            </td>\n          </tr>\n\n          <!-- Appointment Details Card -->\n          <tr>\n            <td style=\"padding:18px 32px 26px 32px;\">\n\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#f8fafc; border:1px solid #e5e7eb; border-radius:12px; overflow:hidden;\">\n\n                <tr>\n                  <td colspan=\"2\" style=\"padding:16px 20px; background-color:#ecfdf5; border-bottom:1px solid #d1fae5;\">\n                    <div style=\"font-size:15px; font-weight:700; color:#065f46;\">\n                      Appointment Details\n                    </div>\n                  </td>\n                </tr>\n\n                <tr>\n                  <td style=\"width:38%; padding:16px 20px; border-bottom:1px solid #e5e7eb; font-size:14px; color:#6b7280;\">\n                    Date\n                  </td>\n                  <td style=\"padding:16px 20px; border-bottom:1px solid #e5e7eb; font-size:14px; font-weight:700; color:#111827;\">\n                    ${DateTime.fromISO($('Edit Fields').item.json.appointment_start)\n                      .setZone('Asia/Karachi')\n                      .toFormat('cccc, dd LLLL yyyy')}\n                  </td>\n                </tr>\n\n                <tr>\n                  <td style=\"padding:16px 20px; border-bottom:1px solid #e5e7eb; font-size:14px; color:#6b7280;\">\n                    Time\n                  </td>\n                  <td style=\"padding:16px 20px; border-bottom:1px solid #e5e7eb; font-size:14px; font-weight:700; color:#111827;\">\n                    ${DateTime.fromISO($('Edit Fields').item.json.appointment_start)\n                      .setZone('Asia/Karachi')\n                      .toFormat('hh:mm a')}\n                  </td>\n                </tr>\n\n                <tr>\n                  <td style=\"padding:16px 20px; border-bottom:1px solid #e5e7eb; font-size:14px; color:#6b7280;\">\n                    Duration\n                  </td>\n                  <td style=\"padding:16px 20px; border-bottom:1px solid #e5e7eb; font-size:14px; font-weight:700; color:#111827;\">\n                    30 minutes\n                  </td>\n                </tr>\n\n                <tr>\n                  <td style=\"padding:16px 20px; font-size:14px; color:#6b7280;\">\n                    Booking ID\n                  </td>\n                  <td style=\"padding:16px 20px; font-size:14px; font-weight:700; color:#111827; word-break:break-word;\">\n                    ${$('Edit Fields').item.json.booking_id}\n                  </td>\n                </tr>\n\n              </table>\n\n            </td>\n          </tr>\n\n          <!-- CTA -->\n          <tr>\n            <td align=\"center\" style=\"padding:0 32px 28px 32px;\">\n\n              <a href=\"${$('Create Appointment Event').item.json.htmlLink || '#'}\"\n                 style=\"display:inline-block; background-color:#0f766e; color:#ffffff; text-decoration:none; font-size:15px; font-weight:700; padding:14px 24px; border-radius:8px;\">\n                View Appointment\n              </a>\n\n            </td>\n          </tr>\n\n          <!-- Note -->\n          <tr>\n            <td style=\"padding:0 32px 30px 32px;\">\n\n              <div style=\"background-color:#fffbeb; border:1px solid #fde68a; border-radius:10px; padding:16px 18px;\">\n                <div style=\"font-size:14px; line-height:1.6; color:#92400e;\">\n                  <strong>Need to make a change?</strong><br>\n                  Reply to this email or contact the clinic to reschedule or cancel your appointment.\n                </div>\n              </div>\n\n            </td>\n          </tr>\n\n          <!-- Footer -->\n          <tr>\n            <td style=\"background-color:#f8fafc; border-top:1px solid #e5e7eb; padding:24px 30px; text-align:center;\">\n\n              <div style=\"font-size:15px; font-weight:700; color:#111827;\">\n                Bright Smile Dental Clinic\n              </div>\n\n              <div style=\"font-size:13px; line-height:1.7; color:#6b7280; margin-top:8px;\">\n                Thank you for choosing us for your dental care.\n              </div>\n\n              <div style=\"font-size:12px; line-height:1.7; color:#9ca3af; margin-top:12px;\">\n                This is an automated appointment confirmation email.\n              </div>\n\n            </td>\n          </tr>\n\n        </table>\n\n      </td>\n    </tr>\n  </table>\n\n</body>\n</html>`\n}}",
        "options": {
          "appendAttribution": false,
          "senderName": "Bright Smile Dental Clinic"
        }
      },
